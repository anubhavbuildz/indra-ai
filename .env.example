# Copy to .env for local overrides. Values below are safe placeholders.
APP_NAME=Indra API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/indra.db

# Nebius Token Factory OpenAI-compatible endpoint and model.
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/Nemotron-3_5-Lightning
NVIDIA_API_FORMAT=openai-chat-completions
EMBEDDING_MODEL=local-feature-hash-v1
FAISS_INDEX_PATH=./faiss_store/index.faiss
FAISS_METADATA_PATH=./faiss_store/metadata.pkl
KNOWLEDGE_BASE_PATH=./knowledge_base

AWS_REGION=us-east-1
CORS_ORIGINS=
