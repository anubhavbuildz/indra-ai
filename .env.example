# Copy to .env for local overrides. Values below are safe placeholders.
APP_NAME=Indra API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/indra.db

# Optional single-account JWT login. Use a unique secret of at least 32 bytes.
AUTH_USERNAME=
AUTH_PASSWORD=
JWT_SECRET_KEY=

# Nebius Token Factory OpenAI-compatible endpoint and model.
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/Nemotron-3_5-Lightning
NVIDIA_API_FORMAT=openai-chat-completions
INFERENCE_TIMEOUT_SECONDS=120

# Local retrieval uses the same embedding model as the prebuilt FAISS index.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=faiss_store/security.index
FAISS_METADATA_PATH=faiss_store/security.pkl

AWS_REGION=us-east-1
CORS_ORIGINS=
