# Copy to .env for local overrides. Values below are safe placeholders.
APP_NAME=Indra API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/indra.db

# Configure only after selecting and verifying the supported Token Factory API.
NVIDIA_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Set only after verifying that the selected model supports this request format.
NVIDIA_API_FORMAT=
EMBEDDING_MODEL=local-feature-hash-v1
FAISS_INDEX_PATH=./faiss_store/index.faiss
FAISS_METADATA_PATH=./faiss_store/metadata.pkl
KNOWLEDGE_BASE_PATH=./knowledge_base

PROWLER_BIN=prowler
PROWLER_TIMEOUT_SECONDS=900
AWS_REGION=us-east-1
CORS_ORIGINS=
